		"1067288": [
			"**Location:** At the base of a ledge on the southern side of Vercanna's Home Soil",
			[
				{
					"id": 160771,
					"title": "20261110233400_1",
					"file_name": "7c5e7fe7-12d8-49fa-8c3e-6629907e941c.jpg",
					"attribution": "",
					"url": "https://media.mapgenie.io/storage/media/7c5e7fe7-12d8-49fa-8c3e-6629907e941c.jpg",
					"type": "image",
