# Copy to .env.ses and fill in. Never commit the real file.
# Uses dedicated SES_* variable names so they never collide with R2's AWS_* variables in .env.r2.
SES_REGION=us-east-1
SES_ACCESS_KEY_ID=replace-me
SES_SECRET_ACCESS_KEY=replace-me
SES_FROM_EMAIL=noreply@atlas.verticordia.com
SES_FROM_NAME=Verticordia Atlas
# Optional: custom SES configuration set name or custom endpoint
# SES_CONFIGURATION_SET=
# SES_ENDPOINT=